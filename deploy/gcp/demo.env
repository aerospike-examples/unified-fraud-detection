# Aerospike KV cluster (seed node — aerolab4-demo-amd-1)
AEROSPIKE_HOST=10.50.15.198
AEROSPIKE_KV_PORT=3000
AEROSPIKE_NAMESPACE=test

# Aerospike Graph Service
GRAPH_HOST_ADDRESS=10.128.0.41

# Data-source mode: "remote" for the externally bulk-loaded billion-scale graph
# (counts from graph summary, Admin ingest/detection disabled). Use "local" for
# a self-contained app-managed dataset.
DATA_SOURCE_MODE=remote

# Public URL for browser-side investigation SSE (demo-app external IP)
NEXT_PUBLIC_BACKEND_URL=http://35.253.223.93:4000

LLM_PROVIDER=gemini
# gemini-2.0-flash was retired by Google (404 "no longer available"); use a
# current GA flash model. Verify availability via the ListModels API if it 404s.
GEMINI_MODEL=gemini-2.5-flash

# ADK / google-genai require GOOGLE_API_KEY (same value as GEMINI_API_KEY is fine).
# Get a key at https://aistudio.google.com/apikey. Leave BLANK in git — the deploy
# merges the real key from the demo-app host's ~/unified-fraud-detection/.env.
GOOGLE_API_KEY=
GEMINI_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Investigation engine: adk (demo default), langgraph, or mock (offline tests)
INVESTIGATION_ENGINE=adk
ADK_MODEL=gemini-2.5-flash

# Query bounds — a slow/hanging graph traversal is aborted server-side
# (evaluationTimeout) and by the client transport, so it can never freeze an
# investigation. TOOL_TIMEOUT_S is a final backstop above both.
GRAPH_QUERY_TIMEOUT_MS=30000
GRAPH_READ_TIMEOUT_S=45
GRAPH_WRITE_TIMEOUT_S=20
TOOL_TIMEOUT_S=90
