# Google ADK / Gemini configuration
# Get an API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key-here
# Use the Gemini Developer API (not Vertex AI)
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Investigation engine: adk (default), langgraph, or mock (no LLM — for tests/demos)
INVESTIGATION_ENGINE=adk

# Mock engine options (INVESTIGATION_ENGINE=mock only)
# MOCK_FORCE_HITL=true
# MOCK_INVESTIGATION_DELAY_MS=0

# LLM provider for both engines: gemini or ollama
LLM_PROVIDER=gemini

# Model the ADK / LangGraph agents use when LLM_PROVIDER=gemini
ADK_MODEL=gemini-3.1-flash-lite

# Ollama settings when LLM_PROVIDER=ollama (run Ollama on the host, not in compose)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Frontend login gate (optional). When both are set, every page and API
# route requires signing in with this exact username/password — there's no
# user database, just this one pair. Leave both unset to disable the login
# gate entirely (e.g. for local dev).
# AUTH_USERNAME=admin
# AUTH_PASSWORD=change-me
